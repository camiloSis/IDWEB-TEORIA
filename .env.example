# Copia este archivo a `.env` y ajusta los valores.
# NUNCA subas el `.env` real al repositorio (ya está en .gitignore).

# PostgreSQL (instancia externa administrada con pgAdmin 4)
# Ejecución local: POSTGRES_HOST=localhost
# Ejecución en Docker (network_mode: host, Linux): POSTGRES_HOST=localhost
#   (el contenedor comparte la red del host; no se expone PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=proyecto_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# Administrador del panel
ADMIN_USER=admin
ADMIN_PASSWORD=admin123